#!/bin/sh
# Ulysses (STM32H745, CM7 + CM4) on the simulator. Prints the lines the firmware side really produces, as they happen:
#  1. main firmware: sim --trace-symbol hits on each core's StartDefaultTask + the first interrupt-trace lines (the firmware prints nothing).
#  2. dev/ivan/baro firmware: the BARO lines the CM7 prints on USART3, verbatim, each followed by "=>" and the value decoded here.
# The sim writes to a log file and this script prints new lines once a second, so a slow terminal never throttles the sim.
# Usage: ./demo   Needs `sim` on PATH (or SIM=/path/to/sim). The firmware images are committed in sim/fw.
set -eu
SIM="${SIM:-sim}"
cd "$(dirname "$0")/sim"
command -v "$SIM" >/dev/null || { echo "sim not found. Install it: curl -fsSL https://simantic.com/install | sh" >&2; exit 1; }
mkdir -p out
stream() { # logfile awk-program: run "$@" into logfile, print new lines through the awk program as they appear
  log=$1; prog=$2; shift 2
  : > "$log"; "$@" > "$log" 2>&1 & pid=$!; n=0
  while :; do
    alive=1; kill -0 "$pid" 2>/dev/null || alive=0
    total=$(wc -l < "$log")
    if [ "$total" -gt "$n" ]; then tail -n +$((n + 1)) "$log" | head -n $((total - n)) | awk "$prog"; n=$total; fi
    [ "$alive" = 1 ] || break
    sleep 1
  done
  wait "$pid"
}
T=""; for a in 0x08009e14 0x0810ad4c 0x08009a84 0x0810ab2c 0x0800af28 0x0810be58 0x08009668 0x0810a878; do T="$T --trace-symbol $a"; done
echo "# main firmware, both cores (CM7 StartDefaultTask=0x08009e14, CM4=0x0810ad4c)"
stream out/boot.log '/\(TRACE\)|^Elapsed/' "$SIM" run --scenario scenario-boot.yaml --timeout 0.3 --trace-interrupts $T
echo "# first interrupt-trace lines of that run (both cores, 4730 enter/exit records in total):"
grep -m4 '(IRQ)' out/boot.log
echo
echo "# dev/ivan/baro firmware: BMP585 driver on the CM7, scripted barometer peer on I2C1 0x46; USART3 lines verbatim"
stream out/baro.log '/BARO n=/ { for (i = 1; i <= NF; i++) { split($i, kv, "="); v[kv[1]] = kv[2] }
           printf "%s   => %.2f hPa %.2f C\n", $0, v["Pa"] / 100, v["mC"] / 1000; next }
         /BARO/' "$SIM" run --scenario scenario.yaml --timeout 2.2 --ascii
echo "# run finished: 2.2 virtual s, firmware printed BARO done"
