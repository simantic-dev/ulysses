Output media/ulysses-demo.gif
Set Shell zsh
Set Theme "Catppuccin Mocha"
Set Width 1280
Set Height 740
Set FontSize 16
Set Padding 18
Set Framerate 10
Set PlaybackSpeed 10
Env PS1 "$ "
Hide
Type 'export PATH="$HOME/.local/bin:$PATH" && cd "$(git rev-parse --show-toplevel)" && clear' Enter
Show
Type "./demo" Enter
Wait+Screen@900s /driver loop finished/
Sleep 100s
